"""Middlewares, resolved by file name.

Each middleware lives in its own file named after the class, so that

    from app.Http.Middleware import MyMiddleware

finds it in MyMiddleware.py with nothing registered here first. Add a file and it
is importable immediately.
"""

import importlib
import sys


def __getattr__(name):
    try:
        module = importlib.import_module("." + name, __name__)
    except ImportError as error:
        raise AttributeError(
            "No middleware named [{}] in app/Http/Middleware. "
            "Create it with:  bazimya make:middleware {}".format(name, name)
        ) from error

    try:
        value = getattr(module, name)
    except AttributeError:
        raise AttributeError(
            "app/Http/Middleware/{}.py does not define a class called {}.".format(name, name)
        ) from None

    # Importing the submodule bound it here under this same name. Rebind to the
    # class, or `from app.Http.Middleware import MyMiddleware` hands back the module instead —
    # which fails much later, somewhere far less obvious.
    setattr(sys.modules[__name__], name, value)

    return value
