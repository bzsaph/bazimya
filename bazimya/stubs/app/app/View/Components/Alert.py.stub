"""The <x-alert> component.

    <x-alert type="error">Something went wrong.</x-alert>

Attributes on the tag become constructor arguments. The template is
resources/views/components/alert.baz.html.
"""

from bazimya import Component


class Alert(Component):
    # Bootstrap has no alert-error; "error" is the word people reach for, so
    # accept it and translate. Same for the other two aliases.
    ALIASES = {"error": "danger", "notice": "info", "ok": "success"}

    def __init__(self, type="info", dismissible=False):
        self.type = type
        self.dismissible = dismissible

    def classes(self):
        variant = self.ALIASES.get(self.type, self.type)
        classes = ["alert", "alert-" + variant]

        if self.dismissible:
            classes += ["alert-dismissible", "fade", "show"]

        return " ".join(classes)
