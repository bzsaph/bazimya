APP_NAME="{{name}}"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY={{key}}
APP_TIMEZONE=UTC

# sqlite needs nothing installed; the file is created on first use.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# MySQL / Postgres
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

EXTENSIONS_ENABLED=true
LOG_LEVEL=error
