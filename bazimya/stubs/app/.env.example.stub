APP_NAME="{{name}}"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY={{key}}
APP_TIMEZONE=UTC

# sqlite needs nothing installed; the file is created on first use.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# MySQL / Postgres
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Turn this on once the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# "log" writes emails to storage/logs/mail.log instead of sending them.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="{{name}}"

EXTENSIONS_ENABLED=true
LOG_LEVEL=error
