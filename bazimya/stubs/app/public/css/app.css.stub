/* Your application's own styles.

   Bootstrap does the heavy lifting (loaded from a CDN in
   resources/views/layouts/app.baz.html). This file is only for the few things
   Bootstrap does not cover. Keep it small, or replace it entirely. */

.tracking {
    letter-spacing: .08em;
}

/* Code samples read better with a tinted background than with Bootstrap's
   default transparent one. */
pre code,
code {
    font-size: .875em;
}

pre {
    background: var(--bs-tertiary-bg);
    border-radius: var(--bs-border-radius);
}

/* Validation messages rendered by <x-input-error>. */
.input-error {
    list-style: none;
    margin: .35rem 0 0;
    padding: 0;
    color: var(--bs-danger-text-emphasis);
    font-size: .875rem;
}
