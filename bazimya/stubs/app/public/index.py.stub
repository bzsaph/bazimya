#!/usr/bin/env python3
"""CGI front controller.

Only used on hosts that offer neither Passenger nor a persistent process —
the last-resort deployment. It starts a fresh interpreter per request, so it
is slow, but it works where nothing else does.

Passenger and gunicorn both bypass this file entirely.
"""

import os
import sys
from wsgiref.handlers import CGIHandler

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from bootstrap.app import create_app  # noqa: E402

CGIHandler().run(create_app())
