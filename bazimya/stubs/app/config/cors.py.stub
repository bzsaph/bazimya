"""Cross-origin request configuration, used by the HandleCors middleware.

`allowed_origins` is ["*"] by default, which is fine for a public read-only
API. Narrow it to the sites you actually serve before putting anything behind
authentication.
"""

config = {
    "paths": ["api/*"],
    "allowed_methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
    "allowed_origins": ["*"],
    "allowed_headers": ["Content-Type", "Authorization", "X-Requested-With", "X-CSRF-TOKEN"],
    "exposed_headers": [],
    "max_age": 3600,
    "supports_credentials": False,
}
