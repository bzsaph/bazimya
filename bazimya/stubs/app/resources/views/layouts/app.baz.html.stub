    {{-- Bazimya ships no asset pipeline, so Bootstrap comes from a CDN. If the
         server has no outbound network, download the two files into public/
         and point these tags at them instead. --}}
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous">
    <link rel="stylesheet" href="/css/app.css">

    <script>
        // Follow the reader's system setting. Bootstrap 5.3 reads this attribute.
        document.documentElement.setAttribute(
            'data-bs-theme',
            window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        );
    </script>
</head>
