    @python
    features = [
        ('Routing', 'Route.get(\'/\', [HomeController, \'index\'])'),
        ('Models', 'User.where(\'active\', 1).order_by(\'name\').get()'),
        ('Migrations', 'with Schema.create(\'posts\') as table:'),
        ('Extensions', 'bazimya make:extension Blog'),
    ]

    steps = [
        ('Add a route', 'routes/web.py'),
        ('Make a controller', 'bazimya make:controller PostController --resource'),
        ('Make a model and its migration', 'bazimya make:model Post -m'),
        ('Run the migrations', 'bazimya migrate'),
        ('Ship it', 'bazimya build --shared'),
    ]
    @endpython

    <h2 class="h4 fw-semibold mb-4">What is in the box</h2>

    <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
        @foreach label, example in features
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold mb-2">{{ label }}</h3>
                        <code class="small text-body-secondary d-block text-break">{{ example }}</code>
                    </div>
                </div>
            </div>
        @endforeach
    </div>

    <h2 class="h4 fw-semibold mb-4">Where to go next</h2>

    <ol class="list-group list-group-numbered mb-5">
        @foreach title, command in steps
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>{{ title }}</span>
                <code class="small text-body-secondary text-break">{{ command }}</code>
            </li>
        @endforeach
    </ol>

