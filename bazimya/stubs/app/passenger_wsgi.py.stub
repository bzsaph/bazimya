"""Entry point for Phusion Passenger.

This is the file cPanel's "Setup Python App" looks for. Point the application
root at this project, set the startup file to passenger_wsgi.py and the entry
point to `application`, then hit Restart.

Nothing here is specific to Passenger beyond the name: `application` is a
plain WSGI callable, so gunicorn and uWSGI use the same object.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from bootstrap.app import create_app  # noqa: E402 — the path must be set first

application = create_app()
