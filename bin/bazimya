#!/usr/bin/env php
<?php

/*
 * Bazimya CLI entry point.
 *
 * This binary has to work in two very different situations:
 *
 *   1. Globally installed (composer global require bazimya/bazimya) and run
 *      from anywhere — e.g. "bazimya new blog". Only the framework is needed.
 *
 *   2. Run from inside a Bazimya application — e.g. "bazimya serve". Here the
 *      application's own autoloader must also be loaded so that App\* classes
 *      (controllers, models) can be resolved.
 *
 * We therefore load the framework autoloader first, then layer the project
 * autoloader on top when the current directory looks like a Bazimya app.
 */

define('BAZIMYA_ROOT', dirname(__DIR__));

$frameworkAutoloaders = [
    BAZIMYA_ROOT . '/vendor/autoload.php',      // installed standalone / from source
    BAZIMYA_ROOT . '/../../autoload.php',       // installed as a dependency
];

$loaded = false;
foreach ($frameworkAutoloaders as $autoloader) {
    if (file_exists($autoloader)) {
        require $autoloader;
        $loaded = true;
        break;
    }
}

if (! $loaded) {
    fwrite(STDERR, "Bazimya: could not locate the Composer autoloader.\n");
    fwrite(STDERR, "Run \"composer install\" inside " . BAZIMYA_ROOT . "\n");
    exit(1);
}

// Layer the application's autoloader on top when we are inside a project.
$projectAutoloader = getcwd() . '/vendor/autoload.php';
if (file_exists($projectAutoloader) && realpath($projectAutoloader) !== realpath($frameworkAutoloaders[0])) {
    require $projectAutoloader;
}

exit((new Bazimya\Console\Kernel())->run($argv));
