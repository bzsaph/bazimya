{
    "name": "bazimya/bazimya",
    "description": "Bazimya — a PHP framework with first-class Python services.",
    "type": "library",
    "keywords": ["framework", "php", "python", "mvc", "bazimya"],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "Bazimya\\": "src/"
        }
    },
    "bin": [
        "bin/bazimya"
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
